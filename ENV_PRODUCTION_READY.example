# Velmère production ENV template — PASS2105
# Copy to Vercel/GitHub Actions secrets. Never commit real values.

# Public site
NEXT_PUBLIC_SITE_URL=https://velmere.example
STORE_BASE_CURRENCY=EUR

# Supabase/Postgres
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=server_only_service_role_key
VELMERE_PRODUCTS_DB_READ_ENABLED=1

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# PASS2364 — Stripe/BLIK test-mode readiness and VLM service replay
# Keep BLIK false until it is enabled in Stripe Dashboard and you have a PLN checkout price.
VELMERE_STRIPE_BLIK_ENABLED=false
VELMERE_BLIK_PRO_ANALYSIS_PLN_AMOUNT=
VELMERE_BLIK_PRO_PDF_PLN_AMOUNT=
VELMERE_BLIK_PRO_AUDIT_PLN_AMOUNT=
VELMERE_BLIK_ADVANCED_ANALYSIS_PLN_AMOUNT=
VELMERE_BLIK_ADVANCED_PDF_PLN_AMOUNT=
VELMERE_BLIK_ADVANCED_AUDIT_PLN_AMOUNT=
CHECKOUT_MODE=stripe
STORE_COMMERCIAL_READY=false

# Admin / operator gate
VELMERE_ADMIN_SESSION_SECRET=replace_with_32_plus_random_chars
VELMERE_ADMIN_OWNER_EMAILS=owner@example.com
# Development/import tooling only. It is deliberately rejected by production routes.
ADMIN_IMPORT_TOKEN=

# Provider sandbox/live fulfilment
PRINTFUL_API_TOKEN=server_only_printful_token
PRINTFUL_STORE_ID=printful_store_id
PRINTFUL_CONFIRM_ORDERS=false
TAPSTITCH_API_KEY=server_only_tapstitch_key_or_BLOCKED

# Rate limiting / durable audit queues
UPSTASH_REDIS_REST_URL=https://...
UPSTASH_REDIS_REST_TOKEN=server_only_upstash_token
QSTASH_TOKEN=server_only_qstash_token

# AI / reports
GEMINI_API_KEY=server_only_gemini_key
VELMERE_GEMINI_MODEL=gemini-2.5-flash
VELMERE_VLM_RECEIPT_SECRET=replace_with_32_plus_random_chars

# Wallet / Web3 public key only
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=walletconnect_project_id

# Production truth mode
VELMERE_ENV_STRICT=1
VELMERE_RATE_LIMIT_DISABLED=0
VELMERE_AUDIT_APPEND_DISABLED=0
NEXT_PUBLIC_VELMERE_OPERATOR_DIAGNOSTICS=0
NEXT_PUBLIC_VELMERE_SHOW_PDF_QA=0

# PASS2223 paid Advanced fail-closed
VELMERE_SERVICES_COMMERCIAL_READY=true
VELMERE_PAID_ACCESS_SECRET=replace_with_32_plus_random_chars
VELMERE_PAID_ACCESS_TTL_MS=2592000000
VELMERE_REQUIRE_PAID_ENTITLEMENT_LEDGER=true
VELMERE_LOCAL_PAID_ACCESS_DEMO=false
VELMERE_LOCAL_PAID_TIER_DEMO_UNLOCK=false


# PASS2281 Velmère paid audit/payment readiness
# Advanced Audit / VLM Advanced is unlocked only after server-side confirmation.
VELMERE_ADVANCED_AUDIT_PRICE_EUR=149
VELMERE_ADVANCED_AUDIT_PRICE_CENTS=14900
VELMERE_PAYMENT_CONFIRMATION_MODE=server_side_only
# Optional Web3 payment confirmation adapters. Keep private keys server-side only.
VELMERE_WEB3_PAYMENT_ENABLED=false
VELMERE_WEB3_PAYMENT_CHAIN=ethereum_sepolia
VELMERE_WEB3_TREASURY_ADDRESS=
VELMERE_WEB3_RPC_URL=
VELMERE_WEB3_CONFIRMATIONS=2

# PASS2363 AUTH / GOOGLE LOGIN
# Google login remains preview-only until these are configured in Supabase Auth / Google Cloud OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_VELMERE_AUTH_MODE=preview_skeleton

# PASS4395 production mutation idempotency.
# Required for public paid launch / topka claim: choose one durable provider and set fail closed.
VELMERE_DURABLE_IDEMPOTENCY_REQUIRED=1
VELMERE_IDEMPOTENCY_FAIL_CLOSED=1
# Preferred KV option:
# PASS4400_DEDUPED_DUPLICATE_ENV_KEY: UPSTASH_REDIS_REST_URL=
# PASS4400_DEDUPED_DUPLICATE_ENV_KEY: UPSTASH_REDIS_REST_TOKEN=
# Or Supabase/Postgres after applying lib/db/schema.sql:
# PASS4400_DEDUPED_DUPLICATE_ENV_KEY: NEXT_PUBLIC_SUPABASE_URL=
# PASS4400_DEDUPED_DUPLICATE_ENV_KEY: SUPABASE_SERVICE_ROLE_KEY=

# PASS4645 provider evidence ledger
# Required in production for signed provider evidence ledgers. Use a strong secret from your secret manager.
VELMERE_PROVIDER_RECEIPT_SIGNING_SECRET=
# Optional local/Windows durable store. Production should prefer Supabase.
VELMERE_PROVIDER_RECEIPT_STORE_DIR=

# PASS4649 staging proof runner
VELMERE_STAGING_BASE_URL=https://staging.example.com
# Uses VELMERE_PROVIDER_RECEIPT_SIGNING_SECRET declared above.
VELMERE_STAGING_HEADERS_JSON={}
