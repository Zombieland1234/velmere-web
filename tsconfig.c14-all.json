{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true,
    "strict": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    "**/*.cts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".next/**",
    ".generated",
    ".generated/**",
    "artifacts",
    "artifacts/**",
    "archive",
    "archive/**",
    ".velmere",
    ".velmere/**",
    "**/*.ts.txt",
    "**/*.tsx.txt"
  ]
}
