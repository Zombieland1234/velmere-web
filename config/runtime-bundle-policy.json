{
  "schemaVersion": "velmere.runtime-bundle-policy.v1",
  "profile": "deployment-source-runtime",
  "manifestPath": "_velmere/runtime/VELMERE_RUNTIME_BUNDLE_MANIFEST.json",
  "includedDirectoryPrefixes": [
    "app/",
    "components/",
    "data/",
    "lib/",
    "messages/",
    "public/",
    "scripts/deployment/",
    "store/"
  ],
  "includedExactPaths": [
    ".env.example",
    ".node-version",
    ".npmrc",
    ".nvmrc",
    "config/pass21/merchant-legal-profile.json",
    "i18n.ts",
    "navigation.ts",
    "next-env.d.ts",
    "next.config.mjs",
    "package-lock.json",
    "package.json",
    "postcss.config.js",
    "proxy.ts",
    "routing.ts",
    "scripts/lib/velmere-runtime-contract.mjs",
    "scripts/verify-runtime-contract.mjs",
    "tailwind.config.ts",
    "tsconfig.json",
    "vercel.json"
  ],
  "excludedDirectoryPrefixes": [
    ".git/",
    ".github/",
    ".next/",
    "node_modules/",
    "artifacts/",
    "coverage/",
    "docs/",
    "evaluation/",
    "fixtures/",
    "playwright-report/",
    "test-results/",
    "tests/",
    ".velmere/cache/",
    ".velmere/quarantine/",
    "app/[locale]/runtime-proof/",
    "app/api/proof-status/"
  ],
  "excludedExactPaths": [
    ".velmere/orphan-quarantine-pass6.json",
    "PASS4606_CHECK_RESULTS.json",
    "PASS4608_CHECK_RESULTS.json",
    "VELMERE_PASS8_CODE_ONLY_HANDOFF.md",
    "VELMERE_PASS8_MASTER_AUDYT_PL.txt",
    "VELMERE_RUN_FULL_CHECK.ps1",
    "VLM_PASS5_MASTER_WORLDCLASS_PL.txt",
    "_velmere/PASS4826_RELEASE_MANIFEST.json",
    "_velmere/VLM_PASS5_RELEASE_MANIFEST.json",
    "lib/security/runtime-evidence-test-pack.ts",
    "lib/security/runtime-replay-artifact-collector.ts",
    "lib/security/runtime-replay-artifact-storage-adapter.ts",
    "lib/security/supabase-release-evidence-board-migration-rls-gate.ts",
    "lib/security/supabase-rls-policy-regression-fixture-runner.ts"
  ],
  "requiredPaths": [
    ".env.example",
    ".node-version",
    ".npmrc",
    ".nvmrc",
    "app",
    "components",
    "config/pass21/merchant-legal-profile.json",
    "data",
    "lib",
    "messages",
    "next.config.mjs",
    "package-lock.json",
    "package.json",
    "postcss.config.js",
    "public",
    "scripts/deployment/common.mjs",
    "scripts/deployment/preflight.mjs",
    "scripts/deployment/run-build-watchdog.mjs",
    "scripts/lib/velmere-runtime-contract.mjs",
    "scripts/verify-runtime-contract.mjs",
    "store",
    "tailwind.config.ts",
    "tsconfig.json"
  ],
  "proofPlaneForbiddenPrefixes": [
    ".github/",
    ".velmere/",
    "artifacts/",
    "db/",
    "docs/",
    "evaluation/",
    "fixtures/",
    "scripts/pass",
    "supabase/",
    "tests/",
    "app/[locale]/runtime-proof/",
    "app/api/proof-status/"
  ],
  "proofPlaneForbiddenExactPaths": [
    "lib/security/runtime-evidence-test-pack.ts",
    "lib/security/runtime-replay-artifact-collector.ts",
    "lib/security/runtime-replay-artifact-storage-adapter.ts",
    "lib/security/supabase-release-evidence-board-migration-rls-gate.ts",
    "lib/security/supabase-rls-policy-regression-fixture-runner.ts"
  ],
  "runtimeSourceRoots": [
    "app",
    "components",
    "lib",
    "store",
    "i18n.ts",
    "navigation.ts",
    "proxy.ts",
    "routing.ts"
  ],
  "forbiddenRuntimeImportRoots": [
    ".github",
    ".velmere",
    ".velmere/cache",
    ".velmere/quarantine",
    "artifacts",
    "config",
    "db",
    "docs",
    "evaluation",
    "fixtures",
    "scripts",
    "supabase",
    "tests"
  ]
}
