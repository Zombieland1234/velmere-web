      "claims",
      "claimSourceBindings",
      "policyDecision"
    ],
    "angel": [
      "answer",
      "severity",
      "evidenceSummary",
      "missingProof",
      "safeRemediation",
      "policyDecision"
    ]
  },
  "advancedAuditHumanReview": {
    "required": false,
    "claimRequiresValidReceipt": true,
    "requiredFields": [
