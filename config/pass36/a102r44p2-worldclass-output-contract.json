    "analysisMode": "automated_informational",
    "requiredFields": [
      "analysisMode",
      "claimBoundary",
      "tierValue",
      "methodology",
      "evidenceCoverage"
    ],
    "minimumIndependentSourceFamilies": 3,
    "independentCertificationClaimAllowed": false,
    "personalisedAdviceAllowed": false,
    "securityGuaranteeAllowed": false
  }
