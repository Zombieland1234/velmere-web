    "advanced": {
      "requiredFields": [
        "evidenceTable",
        "riskDrivers",
        "contradictions",
        "confidenceBasis",
        "commercialRights",
        "freshnessReceipt",
        "provenanceReceipt"
      ],
      "minimumIndependentSourceFamilies": 3,
      "mustBlockOnMissingEvidence": true,
      "mustDifferMateriallyFromPro": true
    }
  },
  "surfaceRequirements": {
    "shield": [
      "assetIdentity",
      "marketSnapshot",
      "liquidity",
