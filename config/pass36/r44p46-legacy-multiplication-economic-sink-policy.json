  "compilerBoundary": {
    "eligible": ">=0.4.0 <0.8.0",
    "notApplicable": ">=0.8.0",
    "authority": "exact executed solc.version(), never pragma text alone"
  },
  "supportedScope": {
    "arithmetic": "unsigned BinaryOperation multiplication",
    "taint": "external/public function parameter or msg.value/msg.data, direct or local alias in the same function",
    "sinks": [
      "native transfer/send amount",
      "legacy call.value or call options value",
      "contract transfer/transferFrom/approve amount",
      "mint/burn amount",
      "msg.value/address balance/economic-state validation",
      "semantic economic state write"
    ],
    "suppressions": [
      "control-flow-dominating multiplication division-identity check before the sink",
      "control-flow-dominating conjunctive literal upper bounds proving the product fits",
      "operand type/literal range proving the product fits",
      "SafeMath-style method call because it is not an unchecked BinaryOperation",
      "Solidity 0.8 or later because this legacy family is not applicable"
    ]
  },
  "explicitlyUnsupported": [
    "broad arithmetic coverage",
    "interprocedural or cross-contract taint completeness",
    "signed arithmetic",
    "path feasibility",
    "economic loss",
    "exploitability",
    "severity accuracy",
    "formal precision/recall",
    "independent ground truth",
    "real-protocol accuracy"
  ],
