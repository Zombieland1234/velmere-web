    "rights_preflight_before_network",
    "safe_search_or_fetch",
    "server_signed_source_token",
    "basic_preview",
    "server_signed_render_token",
    "single_pdf_render",
    "authenticated_basic_exact_account_artifact_store",
    "same_account_json_readback",
    "same_account_exact_pdf_preview_download_readback",
