    "r6_exact_source_transport_pass",
    "exact_node24_npm11_dependency_campaign_pass",
    "exact_windows_server_2025_pass",
    "r6_staging_foundation_pass",
    "browser_basic_deployed_e2e_pass",
    "field_use_rights_pass",
    "no_open_critical_finding"
  ]
}
