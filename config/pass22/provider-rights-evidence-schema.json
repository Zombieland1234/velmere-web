{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "velmere.pass22.provider-rights-evidence.v1",
  "title": "Velmere reviewed provider rights evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "providerId", "evidenceId", "documentKind", "documentSha256",
    "capturedAt", "effectiveAt", "jurisdiction", "reviewer", "reviewDecision", "rights"
  ],
  "properties": {
    "schemaVersion": {"const": "velmere.pass22.provider-rights-evidence.v1"},
    "providerId": {"type": "string", "pattern": "^[a-z0-9_]{2,64}$"},
    "evidenceId": {"type": "string", "pattern": "^pre_[a-f0-9]{24}$"},
    "documentKind": {"enum": ["SIGNED_CONTRACT", "ORDER_FORM", "TERMS_SNAPSHOT", "DPA", "LICENSE_ADDENDUM"]},
    "documentSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sourceLocationHash": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "capturedAt": {"type": "string", "format": "date-time"},
    "effectiveAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": ["string", "null"], "format": "date-time"},
    "jurisdiction": {"type": "string", "minLength": 2, "maxLength": 120},
    "reviewer": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewerIdHash", "reviewedAt"],
      "properties": {
        "reviewerIdHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "reviewedAt": {"type": "string", "format": "date-time"},
        "legalReview": {"type": "boolean"}
      }
    },
    "reviewDecision": {"enum": ["APPROVED", "REJECTED", "NEEDS_CLARIFICATION"]},
    "rights": {
      "type": "object", "additionalProperties": false,
      "required": ["displayUseAllowed", "commercialUseAllowed", "redistributionAllowed", "modelTrainingAllowed"],
      "properties": {
        "displayUseAllowed": {"type": "boolean"},
        "commercialUseAllowed": {"type": "boolean"},
        "redistributionAllowed": {"type": "boolean"},
        "modelTrainingAllowed": {"type": "boolean"}
      }
    },
    "restrictions": {"type": "array", "items": {"type": "string", "minLength": 2, "maxLength": 500}, "maxItems": 50},
    "notesRedacted": {"type": ["string", "null"], "maxLength": 4000}
  }
}
