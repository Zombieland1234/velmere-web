{
  "schemaVersion": "velmere.pass22.gate-policy.v1",
  "purpose": "Verify fail-closed provider-rights evidence, owner/operator RLS source policies, merchant/legal blockers, expanded PL/EN/DE and the 2700 synthetic adapter contract without repeating heavy runtime gates.",
